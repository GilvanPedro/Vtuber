# String de conexão do Neon (Dashboard do Neon > Connect). Sem ela, "npm run dev" usa um banco local em memória.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha para entrar no painel /admin
ADMIN_PASSWORD=troque-esta-senha

# Texto aleatório com 32+ caracteres (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Contadores do perfil (opcionais; sem eles o bloco de seguidores/inscritos não aparece)
# Twitch: crie um app em https://dev.twitch.tv/console/apps (OAuth Redirect URL: http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: Google Cloud Console > APIs e serviços > ative a "YouTube Data API v3" > Credenciais > Chave de API
YOUTUBE_API_KEY=
